{
  "extraKnownMarketplaces": {
    "cosmos": {
      "source": { "source": "github", "repo": "Shi-Shi-Ki/cosmos" }
    }
  },
  "enabledPlugins": {
    "team-dev@cosmos": true
  },
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(clasp deploy:*)",
      "Bash(clasp push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.tfvars)",
      "Read(./**/.clasprc.json)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Bash(aws * create*)",
      "Bash(aws * delete*)",
      "Bash(aws * put*)",
      "Bash(aws * update*)",
      "Bash(aws * remove*)",
      "Bash(aws * terminate*)",
      "Bash(aws * invoke*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws s3 mv:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 sync:*)",
      "Bash(aws *ssm get-parameter*--with-decryption*)",
      "Bash(docker compose down *-v*)",
      "Bash(docker compose down *--volumes*)",
      "Bash(docker-compose down *-v*)",
      "Bash(docker-compose down *--volumes*)"
    ],
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm exec tsc --noEmit:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)"
    ]
  }
}
